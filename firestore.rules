rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isMember(res) {
      return isAuthenticated() && request.auth.uid in res.data.memberIds;
    }

    function isOwner(res) {
      return isAuthenticated() && request.auth.uid == res.data.ownerId;
    }

    function isOwnerOrEditor(res) {
      return isAuthenticated() && (
        res.data.roles[request.auth.uid] == 'owner' ||
        res.data.roles[request.auth.uid] == 'editor'
      );
    }

    // User profile and settings
    match /users/{userId} {
      allow read, write: if isUser(userId);
    }

    // User directory for email lookup (SHA-256 hash -> uid)
    // Authenticated users can read exact hash doc, but cannot list collection
    match /userDirectory/{emailHash} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Notes
    match /notes/{noteId} {
      allow read: if isMember(resource);
      
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && (!('plainText' in request.resource.data) || request.resource.data.plainText.size() <= 200000)
        && (!('bodyDelta' in request.resource.data) || request.resource.data.bodyDelta.size() <= 900000);

      allow update: if isOwnerOrEditor(resource)
        && request.resource.data.ownerId == resource.data.ownerId
        && (isOwner(resource) || (
          request.resource.data.memberIds == resource.data.memberIds &&
          request.resource.data.roles == resource.data.roles
        ))
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && (!('plainText' in request.resource.data) || request.resource.data.plainText.size() <= 200000)
        && (!('bodyDelta' in request.resource.data) || request.resource.data.bodyDelta.size() <= 900000);

      allow delete: if isOwner(resource);

      // Note version history
      match /history/{vId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/notes/$(noteId)).data.memberIds
        );
        allow create, update: if isAuthenticated() && (
          get(/databases/$(database)/documents/notes/$(noteId)).data.roles[request.auth.uid] in ['owner', 'editor']
        );
        allow delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/notes/$(noteId)).data.ownerId == request.auth.uid
        );
      }
    }

    // Task Lists (Projects)
    match /taskLists/{listId} {
      allow read: if isMember(resource);

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200;

      allow update: if isOwnerOrEditor(resource)
        && request.resource.data.ownerId == resource.data.ownerId
        && (isOwner(resource) || (
          request.resource.data.memberIds == resource.data.memberIds &&
          request.resource.data.roles == resource.data.roles
        ))
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200;

      allow delete: if isOwner(resource);
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isMember(resource);

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && (!('description' in request.resource.data) || request.resource.data.description.size() <= 50000);

      allow update: if isOwnerOrEditor(resource)
        && request.resource.data.ownerId == resource.data.ownerId
        && (isOwner(resource) || (
          request.resource.data.memberIds == resource.data.memberIds &&
          request.resource.data.roles == resource.data.roles
        ))
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 500
        && (!('description' in request.resource.data) || request.resource.data.description.size() <= 50000);

      allow delete: if isOwner(resource);
    }

    // Labels
    match /labels/{labelId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Folders
    match /folders/{folderId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Saved Searches
    match /savedSearches/{id} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}
